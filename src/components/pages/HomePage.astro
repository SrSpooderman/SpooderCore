---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { messages, localizedPath, type Locale } from '../../i18n/locales';
const { locale } = Astro.props as { locale: Locale };
const t = messages(locale, 'home');

const focusAreas = [t.focusBackend, t.focusApis, t.focusDatabases, t.focusArchitecture];
const technologyGroups = [
  {
    category: t.backendArchitecture,
    technologies: [
      'Python',
      'FastAPI',
      'SQL',
      'Java',
      'Spring',
      'Django',
      'REST APIs',
      t.hexagonalArchitecture,
      t.domainModeling,
      t.authentication,
    ],
  },
  {
    category: t.dataInfrastructure,
    technologies: [
      'PostgreSQL',
      'MySQL',
      'Redis',
      'SQLAlchemy',
      'Alembic',
      'Docker',
      'Docker Compose',
      'Linux',
      'Ubuntu Server',
      'Nginx',
      'Coolify',
      'Traefik',
      'Cloudflare',
      'Keycloak',
      'Self-hosting',
    ],
  },
  {
    category: t.frontendDesktop,
    technologies: [
      'React',
      'TypeScript',
      'JavaScript',
      'HTML',
      'CSS',
      'Vite',
      'Puck',
      'PySide6',
      'Kivy',
    ],
  },
  {
    category: t.automationTools,
    technologies: [
      'Git',
      'GitHub',
      'GitHub Actions',
      'GitLab',
      'VS Code',
      'CI/CD',
      t.testing,
      t.deployment,
      'FFmpeg',
      'yt-dlp',
      'RQ',
      'MCP',
      t.embeddedSystems,
      t.microcontrollers,
    ],
  },
];
const projects = [
  {
    number: '01',
    name: 'SpiderFinance',
    description: t.projectSpiderfinance,
    stack: 'Python · FastAPI · PostgreSQL · React',
    href: 'https://github.com/SrSpooderman/SpiderFinance',
  },
  {
    number: '02',
    name: 'Cliponomicon API',
    description: t.projectCliponomicon,
    stack: 'FastAPI · MySQL · Redis · FFmpeg',
    href: 'https://github.com/SrSpooderman/CliponomiconAPI',
  },
  {
    number: '03',
    name: 'SpiderPortfolio',
    description:
      t.projectSpiderportfolio,
    stack: 'React · Puck · FastAPI · PostgreSQL',
    href: 'https://github.com/SrSpooderman/Portfolio/tree/develop',
  },
  {
    number: '04',
    name: 'SpiderToMP3',
    description: t.projectSpidertomp3,
    stack: 'Python · PySide6 · yt-dlp · FFmpeg',
    href: 'https://github.com/SrSpooderman/SpiderToMP3',
  },
];
---

<BaseLayout
  locale={locale}
  active="/"
  title={t.title}
  description={t.description}
>
  <section class="profile-hero wrap">
    <div class="profile-intro">
      <p class="eyebrow profile-kicker">
        <span class="profile-kicker-mark"></span> {t.kicker}
      </p>
      <p class="profile-name-label">{t.hello}</p>
      <h1>
        Francisco
        <br />
        <span>Valencia.</span>
      </h1>
      <p class="profile-role">Backend &amp; Software Developer</p>
      <p class="profile-bio">
        {t.bio}
      </p>
      <div class="profile-actions">
        <a
          class="button button-primary"
          href="https://github.com/SrSpooderman"
          target="_blank"
          rel="noreferrer"
        >
          GitHub <span aria-hidden="true">↗</span>
        </a>
        <a
          class="button button-outline"
          href="https://linkedin.com/in/franciscovaleespa"
          target="_blank"
          rel="noreferrer"
        >
          LinkedIn <span aria-hidden="true">↗</span>
        </a>
      </div>
      <div class="profile-focus" aria-label={t.focusLabel}>
        {focusAreas.map((area) => (
          <span>{area}</span>
        ))}
      </div>
    </div>

    <aside class="profile-card" aria-label={t.profileCard}>
      <div class="profile-card-top">
        <span>{t.profilePublic}</span>
        <span>GITHUB / 2021</span>
      </div>
      <div class="profile-portrait-wrap">
        <div class="profile-portrait-ring"></div>
        <img
          class="profile-portrait"
          src="https://avatars.githubusercontent.com/u/77443507?v=4"
          alt={t.githubAvatar}
          width="176"
          height="176"
          fetchpriority="high"
        />
        <img class="profile-card-logo" src="/brand/spoodercore.png" alt="" width="46" height="46" />
      </div>
      <h2>SrSpooderman</h2>
      <p class="profile-card-name">Francisco Valencia</p>
      <p class="profile-card-role">{t.softwareDeveloper}</p>
      <div class="profile-card-specialties">
        <span>Backend engineering</span>
        <span>{t.apiDevelopment}</span>
        <span>{t.focusArchitecture}</span>
      </div>
      <a
        class="profile-card-link"
        href="https://github.com/SrSpooderman"
        target="_blank"
        rel="noreferrer"
      >
        {t.viewGithub} <span aria-hidden="true">↗</span>
      </a>
    </aside>
  </section>

  <section class="profile-stack-band" aria-label={t.technologiesLabel}>
    <div class="wrap profile-stack-inner">
      <div class="profile-stack-heading">
        <p class="eyebrow">{t.technologiesLabel}</p>
        <h2>
          {t.stackTitle}<span class="period">.</span>
        </h2>
      </div>
      <div class="profile-tech-groups">
        {technologyGroups.map((group, index) => (
          <section class="profile-tech-group">
            <p class="profile-tech-group-index">0{index + 1}</p>
            <h3>{group.category}</h3>
            <div class="profile-tech-list">
              {group.technologies.map((technology) => (
                <span>{technology}</span>
              ))}
            </div>
          </section>
        ))}
      </div>
    </div>
  </section>

  <section class="section wrap profile-work" id="projects">
    <div class="section-heading">
      <div>
        <p class="eyebrow">{t.selectedWork}</p>
        <h2>
          {t.projectsHeading}
        </h2>
      </div>
      <p class="section-intro">
        {t.projectsIntro}
      </p>
    </div>
    <div class="profile-project-list">
      {projects.map((project) => (
        <a class="profile-project" href={project.href} target="_blank" rel="noreferrer">
          <span class="profile-project-number">{project.number}</span>
          <div class="profile-project-main">
            <h3>
              {project.name}
              <span aria-hidden="true">↗</span>
            </h3>
            <p>{project.description}</p>
            <span class="profile-project-stack">{project.stack}</span>
          </div>
          <span class="profile-project-arrow" aria-hidden="true">
            ↗
          </span>
        </a>
      ))}
    </div>
    <a class="profile-all-projects" href={localizedPath(locale, '/projects')}>
      {t.allProjects} <span aria-hidden="true">→</span>
    </a>
  </section>

  <section class="profile-about">
    <div class="wrap profile-about-inner">
      <div>
        <p class="eyebrow">{t.howIWork}</p>
        <h2>
          {t.architectureHeading}
        </h2>
      </div>
      <p>
        {t.architectureIntro}
      </p>
    </div>
  </section>

  <section class="section wrap profile-connect">
    <p class="eyebrow">{t.professionalContact}</p>
    <h2>{t.contactHeading}</h2>
    <div class="profile-actions">
      <a
        class="button button-primary"
        href="https://linkedin.com/in/franciscovaleespa"
        target="_blank"
        rel="noreferrer"
      >
        LinkedIn <span aria-hidden="true">↗</span>
      </a>
      <a class="text-link" href="https://github.com/SrSpooderman" target="_blank" rel="noreferrer">
        {t.exploreGithub} <span aria-hidden="true">→</span>
      </a>
    </div>
  </section>
</BaseLayout>
