---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getProject } from '../../data/projects';
import { messages, localizedPath, type Locale } from '../../i18n/locales';
const { locale } = Astro.props as { locale: Locale };
const t = messages(locale, 'home');
interface GitHubEvent {
  created_at: string;
}

interface GitHubStreakStats {
  totalContributions: number;
  firstContribution: string;
  longestStreak: { start: string; end: string; length: number };
}

let githubStats: GitHubStreakStats | null = null;
try {
  const response = await fetch(
    'https://streak-stats.demolab.com/?user=SrSpooderman&type=json&timezone=Europe%2FMadrid',
    { signal: AbortSignal.timeout(5000) },
  );
  if (response.ok) githubStats = (await response.json()) as GitHubStreakStats;
} catch {
  githubStats = null;
}

const githubEvents: GitHubEvent[] = [];
try {
  for (let page = 1; page <= 3; page += 1) {
    const response = await fetch(
      `https://api.github.com/users/SrSpooderman/events/public?per_page=100&page=${page}`,
      {
        headers: {
          Accept: 'application/vnd.github+json',
          'User-Agent': 'SpooderCore-portal',
          'X-GitHub-Api-Version': '2022-11-28',
        },
        signal: AbortSignal.timeout(5000),
      },
    );
    if (!response.ok) throw new Error('GitHub activity unavailable');
    const events = (await response.json()) as GitHubEvent[];
    if (!Array.isArray(events)) throw new Error('Invalid GitHub activity response');
    githubEvents.push(...events);
    if (events.length < 100) break;
  }
} catch {
  githubEvents.length = 0;
}

function datePartsInMadrid(date: Date): Record<string, string> {
  return Object.fromEntries(
    new Intl.DateTimeFormat('en-GB', {
      timeZone: 'Europe/Madrid',
      year: 'numeric',
      month: '2-digit',
      day: '2-digit',
    })
      .formatToParts(date)
      .filter((part) => part.type !== 'literal')
      .map((part) => [part.type, part.value]),
  );
}

function madridDateKey(date: Date): string {
  const parts = datePartsInMadrid(date);
  return `${parts.year}-${parts.month}-${parts.day}`;
}

function formatDate(date: string, options: Intl.DateTimeFormatOptions): string {
  return new Intl.DateTimeFormat(locale, { ...options, timeZone: 'UTC' }).format(
    new Date(`${date}T12:00:00Z`),
  );
}

const todayMadrid = datePartsInMadrid(new Date());
const activityStart = new Date(`${todayMadrid.year}-${todayMadrid.month}-${todayMadrid.day}T12:00:00Z`);
activityStart.setUTCDate(activityStart.getUTCDate() - 27);
const activityCounts = new Map<string, number>();
for (const event of githubEvents) {
  const key = madridDateKey(new Date(event.created_at));
  activityCounts.set(key, (activityCounts.get(key) ?? 0) + 1);
}
const activityDays = Array.from({ length: 28 }, (_, index) => {
  const date = new Date(activityStart);
  date.setUTCDate(activityStart.getUTCDate() + index);
  const count = activityCounts.get(date.toISOString().slice(0, 10)) ?? 0;
  const level = count === 0 ? 0 : count === 1 ? 1 : count <= 3 ? 2 : count <= 6 ? 3 : 4;
  const formattedDate = formatDate(date.toISOString().slice(0, 10), {
    day: 'numeric',
    month: 'short',
  });
  return {
    count,
    level,
    label: t.activityDay.replace('{date}', formattedDate).replace('{count}', String(count)),
  };
});

const contributionStart = githubStats
  ? formatDate(githubStats.firstContribution, { month: 'short', day: 'numeric', year: 'numeric' })
  : '—';
const longestStreakRange = githubStats
  ? `${formatDate(githubStats.longestStreak.start, { month: 'short', day: 'numeric', year: 'numeric' })} – ${formatDate(githubStats.longestStreak.end, { month: 'short', day: 'numeric', year: 'numeric' })}`
  : '—';
const bioParagraphs = [
  { prefix: t.bioFocusPrefix, emphasis: t.bioFocus, suffix: t.bioFocusSuffix },
  { prefix: t.bioWorkflow },
];

const focusAreas = [
  t.focusBackend,
  t.focusApis,
  t.focusArchitecture,
  t.focusDatabases,
  t.focusDeployments,
];
const technologyGroups = [
  {
    category: t.backendArchitecture,
    technologies: [
      'Python',
      'FastAPI',
      'SQL',
      'Java',
      'Spring',
      'Django',
      'REST APIs',
      t.hexagonalArchitecture,
      t.domainModeling,
      t.authentication,
    ],
  },
  {
    category: t.dataInfrastructure,
    technologies: [
      'PostgreSQL',
      'MySQL',
      'Redis',
      'SQLAlchemy',
      'Alembic',
      'Docker',
      'Docker Compose',
      'Linux',
      'Ubuntu Server',
      'Nginx',
      'Coolify',
      'Traefik',
      'Cloudflare',
      'Keycloak',
      'Self-hosting',
    ],
  },
  {
    category: t.frontendDesktop,
    technologies: [
      'React',
      'TypeScript',
      'JavaScript',
      'HTML',
      'CSS',
      'Vite',
      'Puck',
      'PySide6',
      'Kivy',
    ],
  },
  {
    category: t.automationTools,
    technologies: [
      'Git',
      'GitHub',
      'GitHub Actions',
      'GitLab',
      'VS Code',
      'CI/CD',
      t.testing,
      t.deployment,
      'FFmpeg',
      'yt-dlp',
      'RQ',
      'MCP',
      t.embeddedSystems,
      t.microcontrollers,
    ],
  },
];
const projects = [
  {
    number: '01',
    name: 'Cliponomicon API',
    description: t.projectCliponomicon,
    stack: getProject('cliponomicon-api')!.stack.join(' · '),
    href: 'https://github.com/SrSpooderman/CliponomiconAPI',
  },
  {
    number: '02',
    name: 'SpiderFinance',
    description: t.projectSpiderfinance,
    stack: getProject('spiderfinance')!.stack.join(' · '),
    href: 'https://github.com/SrSpooderman/SpiderFinance',
  },
  {
    number: '03',
    name: 'SpiderToMP3',
    description: t.projectSpidertomp3,
    stack: getProject('spidertomp3')!.stack.join(' · '),
    href: 'https://github.com/SrSpooderman/SpiderToMP3',
  },
  {
    number: '04',
    name: 'ReHuse',
    description: t.projectRehuse,
    stack: getProject('rehuse')!.stack.join(' · '),
    href: 'https://github.com/SrSpooderman/ReHuse',
  },
];
---

<BaseLayout locale={locale} active="/" title={t.title} description={t.description}>
  <section class="profile-hero wrap">
    <div class="profile-intro">
      <p class="profile-name-label">{t.hello}</p>
      <h1>
        Francisco <span>Valencia.</span>
      </h1>
      <p class="profile-role">{t.profileRole}</p>
      <div class="profile-bio">
        {bioParagraphs.map((paragraph) => (
          <p>{paragraph.prefix}{paragraph.emphasis && <strong>{paragraph.emphasis}</strong>}{paragraph.suffix}</p>
        ))}
      </div>
      <div class="profile-actions">
        <a class="button button-primary" href="mailto:francisco.valeespa@gmail.com">
          {t.emailAction} <span aria-hidden="true">↗</span>
        </a>
        <a
          class="button button-outline"
          href="https://linkedin.com/in/franciscovaleespa"
          target="_blank"
          rel="noreferrer"
        >
          LinkedIn <span aria-hidden="true">↗</span>
        </a>
      </div>
      <div class="profile-focus" aria-label={t.focusLabel}>
        {focusAreas.map((area) => (
          <span>{area}</span>
        ))}
      </div>
    </div>

    <aside class="profile-card" aria-label={t.profileCard}>
      <div class="profile-card-top">
        <span>{t.profilePublic}</span>
        <span>GITHUB / 2021</span>
      </div>
      <div class="profile-portrait-wrap">
        <div class="profile-portrait-ring"></div>
        <img
          class="profile-portrait"
          src="https://avatars.githubusercontent.com/u/77443507?v=4"
          alt={t.githubAvatar}
          width="176"
          height="176"
          fetchpriority="high"
        />
        <img
          class="profile-card-logo"
          src="/brand/spoodercore/logo%20spoodercore_icono%20color.svg"
          alt=""
          width="46"
          height="46"
        />
      </div>
      <h2>SrSpooderman</h2>
      <div class="github-stats" aria-label={t.githubStatsLabel}>
        <section class="github-stat github-stat-total">
          <strong class="github-stat-value">{githubStats?.totalContributions.toLocaleString(locale) ?? '—'}</strong>
          <span class="github-stat-label">{t.totalContributions}</span>
          <span class="github-stat-range">{contributionStart} – {t.present}</span>
        </section>
        <section class="github-stat github-stat-activity">
          <span class="github-stat-label">{t.recentActivity}</span>
          <ol class="github-activity-grid" aria-label={t.activityGrid}>
            {activityDays.map((day) => (
              <li
                class="github-activity-day"
                data-level={day.level}
                title={day.label}
                aria-label={day.label}
              ></li>
            ))}
          </ol>
          <span class="github-stat-range">{t.activityPeriod}</span>
        </section>
        <section class="github-stat github-stat-longest">
          <strong class="github-stat-value">{githubStats?.longestStreak.length ?? '—'}</strong>
          <span class="github-stat-label">{t.longestStreak}</span>
          <span class="github-stat-range">{longestStreakRange}</span>
        </section>
      </div>
    </aside>
  </section>

  <section class="profile-stack-band" aria-label={t.technologiesLabel}>
    <div class="wrap profile-stack-inner">
      <div class="profile-stack-heading">
        <p class="eyebrow">{t.technologiesLabel}</p>
        <h2>
          {t.stackTitle}
          <span class="period">.</span>
        </h2>
      </div>
      <div class="profile-tech-groups">
        {technologyGroups.map((group, index) => (
          <section class="profile-tech-group">
            <p class="profile-tech-group-index">0{index + 1}</p>
            <h3>{group.category}</h3>
            <div class="profile-tech-list">
              {group.technologies.map((technology) => (
                <span>{technology}</span>
              ))}
            </div>
          </section>
        ))}
      </div>
    </div>
  </section>

  <section class="section wrap profile-work" id="projects">
    <div class="section-heading">
      <div>
        <p class="eyebrow">{t.selectedWork}</p>
        <h2>{t.projectsHeading}</h2>
      </div>
      <p class="section-intro">{t.projectsIntro}</p>
    </div>
    <div class="profile-project-list">
      {projects.map((project) => (
        <a class="profile-project" href={project.href} target="_blank" rel="noreferrer">
          <span class="profile-project-number">{project.number}</span>
          <div class="profile-project-main">
            <h3>
              {project.name}
              <span aria-hidden="true">↗</span>
            </h3>
            <p class="profile-project-description">{project.description}</p>
            <span class="profile-project-stack">{project.stack}</span>
          </div>
          <span class="profile-project-arrow" aria-hidden="true">
            ↗
          </span>
        </a>
      ))}
    </div>
    <a class="profile-all-projects" href={localizedPath(locale, '/projects')}>
      {t.allProjects} <span aria-hidden="true">→</span>
    </a>
  </section>

  <section class="profile-about">
    <div class="wrap profile-about-inner">
      <div>
        <p class="eyebrow">{t.howIWork}</p>
        <h2>{t.architectureHeading}</h2>
      </div>
      <p class="profile-about-description">{t.architectureIntro}</p>
    </div>
  </section>

  <section class="section wrap profile-connect">
    <p class="eyebrow">{t.professionalContact}</p>
    <h2>{t.contactHeading}</h2>
    <div class="profile-actions">
      <a class="button button-primary" href="mailto:francisco.valeespa@gmail.com">
        {t.emailContact} <span aria-hidden="true">↗</span>
      </a>
      <a
        class="button button-outline"
        href="https://linkedin.com/in/franciscovaleespa"
        target="_blank"
        rel="noreferrer"
      >
        LinkedIn <span aria-hidden="true">↗</span>
      </a>
    </div>
  </section>
</BaseLayout>
