---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { messages, type Locale } from '../../i18n/locales';
const { locale } = Astro.props as { locale: Locale };
const t = messages(locale, 'lab');

const hostSpecs = [
  { label: t.operatingSystem, value: 'Ubuntu 26.04.1 LTS' },
  { label: t.architecture, value: 'x86_64' },
  { label: t.cpuCores, value: '6' },
  { label: t.memoryCapacity, value: '15 GB' },
];
const metrics = [
  { key: 'cpu', name: t.cpu },
  { key: 'memory', name: t.memory },
  { key: 'storage', name: t.storage },
];
---

<BaseLayout locale={locale} active="/lab" title={t.title} description={t.description}>
  <section class="page-hero lab-hero wrap">
    <h1>SpooderServer MK1</h1>
  </section>

  <section class="lab-overview wrap" aria-label={t.serverSpecs}>
    <figure class="lab-server-visual">
      <img
        src="/brand/homeLab/ThinkCentre%20Mini%20en%20fondo%20transparente.png"
        alt={t.serverImageAlt}
        width="1488"
        height="1057"
        loading="lazy"
      />
    </figure>
    <div class="lab-spec-card">
      <p class="eyebrow">{t.serverSpecs}</p>
      <h2>ThinkCentre Mini</h2>
      <dl class="lab-spec-list">
        {hostSpecs.map((spec) => (
          <div class="lab-spec-row">
            <dt>{spec.label}</dt>
            <dd>{spec.value}</dd>
          </div>
        ))}
      </dl>
    </div>
  </section>

  <section class="section wrap lab-section" data-messages={JSON.stringify(t)}>
    <div class="tech-grid server-metric-grid">
      {metrics.map((metric, index) => (
        <article
          class:list={['tech-card', 'server-metric-card', `server-metric-card--${metric.key}`]}
        >
          <h3>{metric.name}</h3>
          <div class="server-metric-readout">
            <span class="server-metric-value" id={`metric-${index}`} aria-label={t.loadingData}>
              —
            </span>
          </div>
          <div
            class="server-metric-track"
            role="progressbar"
            aria-label={`${t.usageOf} ${metric.name}`}
            aria-valuemin="0"
            aria-valuemax="100"
            aria-valuetext={t.waitingForData}
            aria-busy="true"
          >
            <span class="server-metric-fill" id={`metric-bar-${index}`}></span>
          </div>
        </article>
      ))}
    </div>

    <div class="metrics-note">
      <span class="metrics-mark" aria-hidden="true">
        ◎
      </span>
      <div class="metrics-copy">
        <p class="eyebrow">{t.sourceStatus}</p>
        <p class="metrics-timestamp">
          <time id="metrics-timestamp">{t.waitingTimestamp}</time>
        </p>
      </div>
      <span class="coming-chip" id="metrics-freshness" aria-live="polite">
        {t.loading}
      </span>
    </div>
  </section>
</BaseLayout>

<script>
  interface MetricsSummary {
    schema_version: string;
    sampled_at: string;
    stale: boolean;
    host: {
      cpu_percent: number;
      memory_percent: number;
      storage_percent: number;
    };
  }

  const freshness = document.querySelector<HTMLElement>('#metrics-freshness');
  const timestamp = document.querySelector<HTMLTimeElement>('#metrics-timestamp');
  const copy = JSON.parse(
    document.querySelector<HTMLElement>('.lab-section')?.dataset.messages ?? '{}',
  ) as Record<string, string>;

  function formatPercent(value: number): string {
    const locale = document.documentElement.lang;
    return `${value.toLocaleString(locale, { maximumFractionDigits: 1 })}%`;
  }

  function showUnavailable(): void {
    if (freshness) freshness.textContent = copy.offline;
    if (timestamp) timestamp.textContent = copy.sampleUnavailable;
    [0, 1, 2].forEach((index) => {
      const target = document.querySelector<HTMLElement>(`#metric-${index}`);
      if (target) target.setAttribute('aria-label', copy.unavailable);

      const progress = document.querySelector<HTMLElement>(`#metric-bar-${index}`)?.parentElement;
      if (progress) {
        progress.removeAttribute('aria-valuenow');
        progress.setAttribute('aria-valuetext', copy.unavailable);
        progress.setAttribute('aria-busy', 'false');
      }
    });
  }

  try {
    const response = await fetch('/api/metrics/summary', { cache: 'no-store' });
    if (!response.ok) throw new Error('Metrics endpoint unavailable');

    const data = (await response.json()) as MetricsSummary;
    if (
      data.schema_version !== '1.0' ||
      typeof data.sampled_at !== 'string' ||
      typeof data.stale !== 'boolean' ||
      ![data.host?.cpu_percent, data.host?.memory_percent, data.host?.storage_percent].every(
        (value) => typeof value === 'number' && Number.isFinite(value),
      )
    ) {
      throw new Error('Invalid metrics response');
    }

    const sampledAt = new Date(data.sampled_at);
    if (Number.isNaN(sampledAt.valueOf())) throw new Error('Invalid sample timestamp');

    const values = [data.host.cpu_percent, data.host.memory_percent, data.host.storage_percent];
    values.forEach((value, index) => {
      const target = document.querySelector<HTMLElement>(`#metric-${index}`);
      if (target) {
        target.textContent = formatPercent(value);
        target.setAttribute('aria-label', formatPercent(value));
      }

      const progress = document.querySelector<HTMLElement>(`#metric-bar-${index}`)?.parentElement;
      if (progress) {
        const boundedValue = Math.min(100, Math.max(0, value));
        progress.setAttribute('aria-valuenow', String(boundedValue));
        progress.setAttribute('aria-valuetext', formatPercent(value));
        progress.setAttribute('aria-busy', 'false');
        progress.style.setProperty('--metric-value', `${boundedValue}%`);
      }
    });

    if (timestamp) {
      const dateLocale = document.documentElement.lang;
      timestamp.dateTime = data.sampled_at;
      timestamp.textContent = `${copy.lastSample}: ${sampledAt.toLocaleString(dateLocale)}.`;
    }
    if (freshness) freshness.textContent = data.stale ? copy.staleLabel : copy.currentLabel;
  } catch {
    showUnavailable();
  }
</script>
