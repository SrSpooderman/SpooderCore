---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { site } from '../../data/site';
import { messages, localizedPath, type Locale } from '../../i18n/locales';
const { locale } = Astro.props as { locale: Locale };
const t = messages(locale, 'about');
---

<BaseLayout
  locale={locale}
  active="/about"
  title={t.title}
  description={t.description}
>
  <section class="page-hero wrap">
    <p class="eyebrow">{t.eyebrow}</p>
    <h1>
      {t.heading}<span class="period">.</span>
    </h1>
    <p class="page-lede">
      {t.lede}
    </p>
    <div class="page-hero-line">
      <span>{t.heroLineOne}</span>
      <span>{t.heroLineTwo}</span>
    </div>
  </section>

  <section class="section wrap about-section">
    <div class="about-story">
      <p class="eyebrow">{t.profile}</p>
      <h2>
        {t.storyHeading}
      </h2>
      <p>
        {t.storyOne}
      </p>
      <p>
        {t.storyTwo}
      </p>
      <a class="button button-primary" href={localizedPath(locale, '/projects')}>
        {t.viewProjects} <span>→</span>
      </a>
    </div>
    <div class="about-aside">
      <span class="about-aside-symbol" aria-hidden="true">
        S<span>.</span>
      </span>
      <p class="eyebrow">{t.workAreas}</p>
      <div class="principle">
        <b>01</b>
        <span>{t.principleOne}</span>
      </div>
      <div class="principle">
        <b>02</b>
        <span>{t.principleTwo}</span>
      </div>
      <div class="principle">
        <b>03</b>
        <span>{t.principleThree}</span>
      </div>
    </div>
  </section>

  <section class="stack-band">
    <div class="wrap stack-inner">
      <div>
        <p class="eyebrow">{t.tools}</p>
        <h2>
          {t.technologies}
        </h2>
      </div>
      <div class="stack-list">
        <span>Python</span>
        <span>FastAPI</span>
        <span>SQL</span>
        <span>PostgreSQL</span>
        <span>MySQL</span>
        <span>Docker</span>
        <span>Linux</span>
        <span>React</span>
        <span>TypeScript</span>
        <span>Git</span>
      </div>
    </div>
  </section>

  <section class="section wrap about-connect">
    <div>
      <p class="eyebrow">{t.publicProfile}</p>
      <h2>
        {t.findMe}
      </h2>
    </div>
    <div>
      <p>{t.githubDescription}</p>
      <a class="button button-outline" href={site.github} target="_blank" rel="noreferrer">
        {t.githubProfile} <span>↗</span>
      </a>
    </div>
  </section>
</BaseLayout>
