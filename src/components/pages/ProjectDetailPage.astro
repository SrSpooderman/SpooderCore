---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getProject } from '../../data/projects';
import { messages, localizedPath, type Locale } from '../../i18n/locales';
import { formatReleaseDate, formatReleaseSize } from '../../utils/format';

const { slug, readmeHtml, releases, locale } = Astro.props as {
  slug: string;
  readmeHtml: string | null;
  releases: import('../../data/releases').ProjectRelease[];
  locale: Locale;
};
const sourceProject = getProject(slug)!;
const t = messages(locale, 'projects');
const prefix = sourceProject.slug.replace(/-([a-z])/g, (_, letter: string) => letter.toUpperCase());
const project = {
  ...sourceProject,
  summary: t[`${prefix}Summary`],
  description: t[`${prefix}Description`],
  eyebrow: t[`${prefix}Eyebrow`],
  status: sourceProject.statusKey
    ? t[sourceProject.statusKey]
    : sourceProject.featured
      ? t.featured
      : t.catalog,
  contribution: sourceProject.contributionKey
    ? t[sourceProject.contributionKey]
    : sourceProject.slug === 'cliponomicon-api'
      ? t.cliponomiconApiContribution
      : undefined,
  quote: sourceProject.quoteKey ? t[sourceProject.quoteKey] : undefined,
  scopeNote: sourceProject.scopeNoteKey ? t[sourceProject.scopeNoteKey] : undefined,
  featuresTitle: t[`${prefix}FeaturesTitle`],
  contributionEvidenceTitle: t[`${prefix}ContributionEvidence`],
  resourcesTitle: t[`${prefix}ResourcesTitle`],
  screenshotsTitle: t[`${prefix}ScreenshotsTitle`],
  features: sourceProject.featureKeys?.map((key) => t[key]),
  technologyGroups: sourceProject.technologyGroups?.map((group) => ({
    label: t[group.labelKey],
    technologies: group.technologies,
  })),
  documentation: sourceProject.documentation
    ?.filter((item) => !readmeHtml || !item.url.endsWith('/README.md'))
    .map((item) => ({
      label: t[item.labelKey],
      url: item.url,
    })),
  screenshots: sourceProject.screenshots?.map((image) => ({
    ...image,
    alt: t[image.altKey],
  })),
  team: sourceProject.team?.map((member) => ({ ...member, role: t[member.roleKey] })),
};
---

<BaseLayout locale={locale} title={project.name} description={project.summary} active="/projects">
  <section class="detail-hero wrap">
    <a class="back-link" href={localizedPath(locale, '/projects')}>
      {t.backToProjects}
    </a>
    <div class="detail-layout">
      <div class="detail-layout-copy">
        <p class="eyebrow">
          {t.projectLabel} / {project.number}
        </p>
        <h1>
          {project.name}
          <span class="period">.</span>
        </h1>
        <p class="detail-lede">{project.summary}</p>
        <div class="detail-status">
          <span class="status">
            <i></i>
            {project.status}
          </span>
          <span class="tag">{project.eyebrow}</span>
        </div>
      </div>
      {project.logo ? (
        <div class="detail-project-logo">
          <img src={project.logo} alt={t.projectLogo.replace('{name}', project.name)} />
        </div>
      ) : (
        <div class="detail-glyph" aria-hidden="true">
          <span>{project.name.slice(0, 1)}</span>
          <b>SC—{project.number}</b>
        </div>
      )}
    </div>
  </section>
  <section class="detail-body wrap">
    <div class="detail-main">
      <p class="eyebrow">{t.aboutProject}</p>
      <p class="detail-description">{project.description}</p>
      {project.quote && <blockquote class="project-quote">“{project.quote}”</blockquote>}
      {project.features && (
        <div class="project-features">
          <p class="eyebrow">{project.featuresTitle}</p>
          <ul>
            {project.features.map((feature) => (
              <li>{feature}</li>
            ))}
          </ul>
        </div>
      )}
      {project.scopeNote && <p class="project-scope-note">{project.scopeNote}</p>}
      {project.contribution && (
        <div class="project-contribution">
          <p class="eyebrow">{t.contribution}</p>
          <p class="project-contribution-description">{project.contribution}</p>
          {sourceProject.contributionSources && (
            <div class="project-contribution-links">
              <span>{project.contributionEvidenceTitle}:</span>
              {sourceProject.contributionSources.map((url, index) => (
                <a href={url} target="_blank" rel="noreferrer">
                  #{index + 1}
                </a>
              ))}
            </div>
          )}
        </div>
      )}
    </div>
    <aside class="detail-aside">
      <p class="eyebrow">{t.details}</p>
      <div class="detail-row">
        <span class="detail-row-label">{t.status}</span>
        <span class="detail-row-value">{project.status}</span>
      </div>
      <div class="detail-row">
        <span class="detail-row-label">{t.area}</span>
        <span class="detail-row-value">{project.eyebrow}</span>
      </div>
      <div class="detail-row">
        <span class="detail-row-label">{t.technologies}</span>
        {project.technologyGroups ? (
          <div class="detail-technology-groups detail-row-value">
            {project.technologyGroups.map((group) => (
              <div class="detail-technology-group">
                <b>{group.label}</b>
                <span>{group.technologies.join(', ')}</span>
              </div>
            ))}
          </div>
        ) : (
          <span class="detail-row-value">{project.stack.join(', ')}</span>
        )}
      </div>
      {project.repository && (
        <a
          class="detail-repository-link"
          href={project.repository}
          target="_blank"
          rel="noreferrer"
        >
          {t.openRepository} <span aria-hidden="true">↗</span>
        </a>
      )}
    </aside>
  </section>
  {project.documentation && (
    <section class="project-doc-links wrap">
      <p class="eyebrow">{project.resourcesTitle}</p>
      <ul>
        {project.documentation.map((item) => (
          <li>
            <a class="project-documentation-link" href={item.url} target="_blank" rel="noreferrer">
              {item.label} ↗
            </a>
          </li>
        ))}
      </ul>
    </section>
  )}
  {project.screenshots && (
    <section class="project-screenshots wrap">
      <p class="eyebrow">{project.screenshotsTitle}</p>
      <div class="project-screenshot-grid">
        {project.screenshots.map((image, index) => (
          <figure class:list={{ 'project-screenshot-featured': index === 0 }}>
            <a href={image.src} target="_blank" rel="noreferrer">
              <img src={image.src} alt={image.alt} loading="lazy" />
            </a>
            <figcaption>{image.alt}</figcaption>
          </figure>
        ))}
      </div>
    </section>
  )}
  {(readmeHtml || releases.length > 0) && (
    <nav class="project-resource-nav wrap" aria-label={t.contents}>
      {readmeHtml && (
        <a href="#readme">
          README <span aria-hidden="true">↓</span>
        </a>
      )}
      {releases.length > 0 && (
        <a href="#descargas">
          {t.downloads} <span aria-hidden="true">↓</span>
        </a>
      )}
    </nav>
  )}
  {project.team && (
    <section class="detail-team wrap">
      <div class="detail-team-heading">
        <p class="eyebrow">{t.collaborative}</p>
        <h2>{t.teamContributions}</h2>
        <p class="detail-team-description">{t.teamDescription}</p>
      </div>
      <ul class="detail-team-list">
        {project.team.map((member) => (
          <li>
            <span class="detail-team-name">{member.name}</span>
            <span class="detail-team-role">{member.role}</span>
          </li>
        ))}
      </ul>
    </section>
  )}
  {readmeHtml && (
    <section class="project-readme wrap" id="readme">
      <div class="project-resource-heading">
        <div class="project-resource-title">
          <p class="eyebrow">{t.repositoryDocs}</p>
          <h2>README</h2>
        </div>
        <a class="project-resource-link" href={project.repository} target="_blank" rel="noreferrer">
          {t.viewOnGithub} ↗
        </a>
      </div>
      <details class="project-readme-details">
        <summary class="project-readme-summary">
          <span>{t.expandReadme}</span>
          <span class="project-readme-icon" aria-hidden="true">
            +
          </span>
        </summary>
        <article class="project-readme-content" set:html={readmeHtml} />
      </details>
    </section>
  )}
  {releases.length > 0 && (
    <section class="project-downloads wrap" id="descargas">
      <div class="project-resource-heading">
        <div>
          <p class="eyebrow">{t.releaseAssets}</p>
          <h2>{t.downloads}</h2>
        </div>
        <a
          class="project-resource-link"
          href={`${project.repository}/releases`}
          target="_blank"
          rel="noreferrer"
        >
          {t.allReleases} ↗
        </a>
      </div>
      <div class="project-release-list">
        {releases.map((release) => (
          <article class="project-release">
            <div class="project-release-heading">
              <a class="project-release-title" href={release.url} target="_blank" rel="noreferrer">
                {release.name}
              </a>
              <time datetime={release.publishedAt}>
                {formatReleaseDate(release.publishedAt, locale)}
              </time>
            </div>
            <ul class="project-release-assets">
              {release.assets.map((asset) => (
                <li>
                  <a href={asset.url} target="_blank" rel="noreferrer" download>
                    <span>{asset.name}</span>
                    <span class="project-release-asset-size">
                      {formatReleaseSize(asset.size)} · {t.download} ↓
                    </span>
                  </a>
                </li>
              ))}
            </ul>
          </article>
        ))}
      </div>
    </section>
  )}
  <section class="detail-next wrap">
    <p class="eyebrow">{t.title}</p>
    <a class="detail-next-link" href={localizedPath(locale, '/projects')}>
      {t.backToList} <span>↗</span>
    </a>
  </section>
</BaseLayout>
