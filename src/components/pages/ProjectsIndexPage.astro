---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { projects } from '../../data/projects';
import { messages, localizedPath, type Locale } from '../../i18n/locales';

const { locale } = Astro.props as { locale: Locale };
const t = messages(locale, 'projects');
const prefixBySlug: Record<string, string> = {
  spiderfinance: 'spiderfinance',
  'cliponomicon-api': 'cliponomiconApi',
  spiderportfolio: 'spiderportfolio',
  spidertomp3: 'spidertomp3',
  spiderawake: 'spiderawake',
  rehuse: 'rehuse',
};
const localizedProjects = projects.map((project) => {
  const key = prefixBySlug[project.slug];
  return {
    ...project,
    summary: t[`${key}Summary`],
    eyebrow: t[`${key}Eyebrow`],
    status: project.featured ? t.featured : t.catalog,
    contribution: project.slug === 'cliponomicon-api' ? t.cliponomiconApiContribution : undefined,
    team: project.team?.map((member) => ({ ...member, role: t[member.roleKey] })),
  };
});
const featuredProjects = localizedProjects.filter((project) => project.featured);
const otherProjects = localizedProjects.filter((project) => !project.featured);
---

<BaseLayout
  locale={locale}
  active="/projects"
  title={t.title}
  description={t.description}
>
  <section class="page-hero wrap projects-page-hero">
    <p class="eyebrow">{t.eyebrow}</p>
    <h1>
      {t.title}<span class="period">.</span>
    </h1>
    <p class="page-lede">{t.lede}</p>
    <div class="page-hero-line">
      <span>{t.heroLineOne}</span>
      <span>{t.heroLineTwo}</span>
    </div>
  </section>

  <section class="section wrap featured-projects-section">
    <div class="featured-project-grid">
      {featuredProjects.map((project) => (
        <article class="featured-project-card">
          <div class="featured-project-visual">
            <span class="featured-project-number">{project.number} / {t.projectLabel}</span>
            <img src={project.logo} alt={`Logo de ${project.name}`} loading="lazy" />
            <span class="featured-project-type">{project.eyebrow}</span>
          </div>
          <div class="featured-project-content">
            <div class="featured-project-title-row">
              <div>
                <p class="eyebrow">{project.status}</p>
                <h2>{project.name}</h2>
              </div>
              <a
                class="featured-project-arrow"
                href={localizedPath(locale, `/projects/${project.slug}`)}
                aria-label={t.viewProject.replace('{name}', project.name)}
              >
                ↗
              </a>
            </div>
            <p class="featured-project-summary">{project.summary}</p>
            {project.contribution && (
              <p class="project-contribution">
                <span>{t.contribution}</span>
                {project.contribution}
              </p>
            )}
            {project.team && (
              <div class="project-team">
                <p class="eyebrow">{t.team}</p>
                <ul>
                  {project.team.map((member) => (
                    <li>
                      <span>{member.name}</span>
                      <span>{member.role}</span>
                    </li>
                  ))}
                </ul>
              </div>
            )}
            <div class="tag-row featured-project-tags">
              {project.stack.map((technology) => (
                <span class="tag">{technology}</span>
              ))}
            </div>
            <div class="featured-project-links">
              <a href={localizedPath(locale, `/projects/${project.slug}`)}>
                {t.projectDetails} <span aria-hidden="true">→</span>
              </a>
              {project.repository && (
                <a href={project.repository} target="_blank" rel="noreferrer">
                  {t.repository} <span aria-hidden="true">↗</span>
                </a>
              )}
            </div>
          </div>
        </article>
      ))}
    </div>
  </section>

  <section class="section wrap other-projects-section">
    <div class="section-heading">
      <div>
        <p class="eyebrow">{t.otherWork}</p>
        <h2>
          {t.moreProjects}
        </h2>
      </div>
      <p class="section-intro">{t.otherIntro}</p>
    </div>
    <div class="other-project-list">
      {otherProjects.map((project) => (
        <article class="other-project-row">
          <span class="other-project-number">{project.number}</span>
          <div>
            <h3>
              <a href={localizedPath(locale, `/projects/${project.slug}`)}>
                {project.name}
                <span aria-hidden="true">↗</span>
              </a>
            </h3>
            <p>{project.summary}</p>
            <div class="tag-row">
              {project.stack.map((technology) => (
                <span class="tag">{technology}</span>
              ))}
            </div>
          </div>
          {project.repository && (
            <a
              class="other-project-repository"
              href={project.repository}
              target="_blank"
              rel="noreferrer"
            >
              GitHub ↗
            </a>
          )}
        </article>
      ))}
    </div>
  </section>
</BaseLayout>
