---
import type { Project } from '../data/projects';
const { project } = Astro.props as { project: Project };
---

<article class:list={['project-card', { archived: project.status === 'Archivado' }]}>
  <div class="card-top">
    {project.logo ? (
      <img src={project.logo} alt={`Logo de ${project.name}`} loading="lazy" />
    ) : (
      <span class="logo-placeholder" aria-hidden="true">
        {project.name.slice(0, 2)}
      </span>
    )}
    <span class="status">{project.status}</span>
  </div>
  <p class="eyebrow">{project.category}</p>
  <h3>
    <a href={`/proyectos/${project.slug}/`}>{project.name}</a>
  </h3>
  <p>{project.summary}</p>
  <ul class="tags">
    {project.technologies
      .flatMap((group) => group.items)
      .slice(0, 5)
      .map((item) => (
        <li>{item}</li>
      ))}
  </ul>
  <a class="text-link" href={`/proyectos/${project.slug}/`}>
    Ver proyecto <span aria-hidden="true">→</span>
  </a>
</article>
