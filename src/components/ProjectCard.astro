---
import type { Project } from '../data/projects';
import { messages } from '../i18n/locales';

const { project } = Astro.props as { project: Project };
const t = messages('es', 'projects');
const key = project.slug.replace(/-([a-z])/g, (_, letter: string) => letter.toUpperCase());
const status = project.statusKey ? t[project.statusKey] : project.featured ? t.featured : t.catalog;
---

<article class="project-card">
  <div class="card-top">
    {project.logo ? (
      <img src={project.logo} alt={t.projectLogo.replace('{name}', project.name)} loading="lazy" />
    ) : (
      <span class="logo-placeholder" aria-hidden="true">
        {project.name.slice(0, 2)}
      </span>
    )}
    <span class="status">{status}</span>
  </div>
  <p class="eyebrow">{t[`${key}Eyebrow`]}</p>
  <h3>
    <a href={`/proyectos/${project.slug}/`}>{project.name}</a>
  </h3>
  <p>{t[`${key}Summary`]}</p>
  <ul class="tags">
    {project.stack.slice(0, 5).map((technology) => (
      <li>{technology}</li>
    ))}
  </ul>
  <a class="text-link" href={`/proyectos/${project.slug}/`}>
    Ver proyecto <span aria-hidden="true">→</span>
  </a>
</article>
