---
import BaseLayout from '../layouts/BaseLayout.astro';

const focusAreas = ['Backend engineering', 'APIs', 'Bases de datos', 'Arquitectura de software'];
const technologyGroups = [
  {
    category: 'Backend y arquitectura',
    technologies: [
      'Python',
      'FastAPI',
      'SQL',
      'Java',
      'Spring',
      'Django',
      'REST APIs',
      'Arquitectura hexagonal',
      'Modelado de dominio',
      'Autenticación',
    ],
  },
  {
    category: 'Datos e infraestructura',
    technologies: [
      'PostgreSQL',
      'MySQL',
      'Redis',
      'SQLAlchemy',
      'Alembic',
      'Docker',
      'Docker Compose',
      'Linux',
      'Ubuntu Server',
      'Nginx',
      'Coolify',
      'Traefik',
      'Cloudflare',
      'Keycloak',
      'Self-hosting',
    ],
  },
  {
    category: 'Frontend y escritorio',
    technologies: [
      'React',
      'TypeScript',
      'JavaScript',
      'HTML',
      'CSS',
      'Vite',
      'Puck',
      'PySide6',
      'Kivy',
    ],
  },
  {
    category: 'Automatización y herramientas',
    technologies: [
      'Git',
      'GitHub',
      'GitHub Actions',
      'GitLab',
      'VS Code',
      'CI/CD',
      'Pruebas',
      'Despliegue',
      'FFmpeg',
      'yt-dlp',
      'RQ',
      'MCP',
      'Sistemas embebidos',
      'Microcontroladores',
    ],
  },
];
const projects = [
  {
    number: '01',
    name: 'SpiderFinance',
    description: 'Aplicación web multiusuario para organizar y consultar finanzas personales.',
    stack: 'Python · FastAPI · PostgreSQL · React',
    href: 'https://github.com/SrSpooderman/SpiderFinance',
  },
  {
    number: '02',
    name: 'Cliponomicon API',
    description: 'Backend modular para gestionar vídeos, procesarlos en segundo plano y servirlos.',
    stack: 'FastAPI · MySQL · Redis · FFmpeg',
    href: 'https://github.com/SrSpooderman/CliponomiconAPI',
  },
  {
    number: '03',
    name: 'SpiderPortfolio',
    description:
      'Editor visual de páginas con componentes reutilizables, borradores y publicación.',
    stack: 'React · Puck · FastAPI · PostgreSQL',
    href: 'https://github.com/SrSpooderman/Portfolio/tree/develop',
  },
  {
    number: '04',
    name: 'SpiderToMP3',
    description: 'Aplicación de escritorio para descargar y convertir contenido multimedia.',
    stack: 'Python · PySide6 · yt-dlp · FFmpeg',
    href: 'https://github.com/SrSpooderman/SpiderToMP3',
  },
];
---

<BaseLayout
  active="/"
  title="Francisco Valencia — Backend & Software Developer"
  description="Francisco Valencia, SrSpooderman. Desarrollador de software centrado en backend, APIs, bases de datos y arquitectura de software."
>
  <section class="profile-hero wrap">
    <div class="profile-intro">
      <p class="eyebrow profile-kicker">
        <span class="profile-kicker-mark"></span> SrSpooderman / PERFIL
      </p>
      <p class="profile-name-label">Hola, soy</p>
      <h1>
        Francisco
        <br />
        <span>Valencia.</span>
      </h1>
      <p class="profile-role">Backend &amp; Software Developer</p>
      <p class="profile-bio">
        Desarrollo software centrado en backend, APIs, bases de datos y arquitectura. También
        trabajo en frontend cuando el proyecto lo necesita, y llevo las aplicaciones desde el diseño
        hasta su despliegue y mantenimiento.
      </p>
      <div class="profile-actions">
        <a
          class="button button-primary"
          href="https://github.com/SrSpooderman"
          target="_blank"
          rel="noreferrer"
        >
          GitHub <span aria-hidden="true">↗</span>
        </a>
        <a
          class="button button-outline"
          href="https://linkedin.com/in/franciscovaleespa"
          target="_blank"
          rel="noreferrer"
        >
          LinkedIn <span aria-hidden="true">↗</span>
        </a>
      </div>
      <div class="profile-focus" aria-label="Áreas de trabajo">
        {focusAreas.map((area) => (
          <span>{area}</span>
        ))}
      </div>
    </div>

    <aside class="profile-card" aria-label="Perfil de GitHub de SrSpooderman">
      <div class="profile-card-top">
        <span>PERFIL PÚBLICO</span>
        <span>GITHUB / 2021</span>
      </div>
      <div class="profile-portrait-wrap">
        <div class="profile-portrait-ring"></div>
        <img
          class="profile-portrait"
          src="https://avatars.githubusercontent.com/u/77443507?v=4"
          alt="Avatar de GitHub de Francisco Valencia"
          width="176"
          height="176"
          fetchpriority="high"
        />
        <img class="profile-card-logo" src="/brand/spoodercore.png" alt="" width="46" height="46" />
      </div>
      <h2>SrSpooderman</h2>
      <p class="profile-card-name">Francisco Valencia</p>
      <p class="profile-card-role">Desarrollador de software</p>
      <div class="profile-card-specialties">
        <span>Backend engineering</span>
        <span>Desarrollo de APIs</span>
        <span>Arquitectura de software</span>
      </div>
      <a
        class="profile-card-link"
        href="https://github.com/SrSpooderman"
        target="_blank"
        rel="noreferrer"
      >
        Ver perfil en GitHub <span aria-hidden="true">↗</span>
      </a>
    </aside>
  </section>

  <section class="profile-stack-band" aria-label="Tecnologías y herramientas">
    <div class="wrap profile-stack-inner">
      <div class="profile-stack-heading">
        <p class="eyebrow">TECNOLOGÍAS Y HERRAMIENTAS</p>
        <h2>
          Stack de trabajo<span class="period">.</span>
        </h2>
      </div>
      <div class="profile-tech-groups">
        {technologyGroups.map((group, index) => (
          <section class="profile-tech-group">
            <p class="profile-tech-group-index">0{index + 1}</p>
            <h3>{group.category}</h3>
            <div class="profile-tech-list">
              {group.technologies.map((technology) => (
                <span>{technology}</span>
              ))}
            </div>
          </section>
        ))}
      </div>
    </div>
  </section>

  <section class="section wrap profile-work" id="projects">
    <div class="section-heading">
      <div>
        <p class="eyebrow">TRABAJO SELECCIONADO</p>
        <h2>
          Proyectos en
          <br />
          <span class="muted-heading">los que trabajo.</span>
        </h2>
      </div>
      <p class="section-intro">
        Algunos proyectos personales, desde servicios backend y procesamiento de archivos hasta
        aplicaciones de escritorio.
      </p>
    </div>
    <div class="profile-project-list">
      {projects.map((project) => (
        <a class="profile-project" href={project.href} target="_blank" rel="noreferrer">
          <span class="profile-project-number">{project.number}</span>
          <div class="profile-project-main">
            <h3>
              {project.name}
              <span aria-hidden="true">↗</span>
            </h3>
            <p>{project.description}</p>
            <span class="profile-project-stack">{project.stack}</span>
          </div>
          <span class="profile-project-arrow" aria-hidden="true">
            ↗
          </span>
        </a>
      ))}
    </div>
    <a class="profile-all-projects" href="/projects">
      Ver todos los proyectos <span aria-hidden="true">→</span>
    </a>
  </section>

  <section class="profile-about">
    <div class="wrap profile-about-inner">
      <div>
        <p class="eyebrow">CÓMO TRABAJO</p>
        <h2>
          Arquitectura,
          <br />
          <span>despliegue y mantenimiento.</span>
        </h2>
      </div>
      <p>
        Me ocupo también de lo que rodea al código: diseño de arquitectura, contenedores,
        despliegues, automatización y mantenimiento. Me interesa construir sistemas comprensibles y
        que puedan evolucionar con el proyecto.
      </p>
    </div>
  </section>

  <section class="section wrap profile-connect">
    <p class="eyebrow">CONTACTO PROFESIONAL</p>
    <h2>¿Hablamos de software?</h2>
    <div class="profile-actions">
      <a
        class="button button-primary"
        href="https://linkedin.com/in/franciscovaleespa"
        target="_blank"
        rel="noreferrer"
      >
        LinkedIn <span aria-hidden="true">↗</span>
      </a>
      <a class="text-link" href="https://github.com/SrSpooderman" target="_blank" rel="noreferrer">
        Explorar GitHub <span aria-hidden="true">→</span>
      </a>
    </div>
  </section>
</BaseLayout>
