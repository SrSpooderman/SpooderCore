---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { projects, type Project } from '../../data/projects';
export function getStaticPaths() {
  return projects.map((project) => ({ params: { slug: project.slug }, props: { project } }));
}
const { project } = Astro.props as { project: Project };
---

<BaseLayout title={project.name} description={project.summary} image={project.logo}>
  <article>
    <header class="project-hero shell">
      <div class="project-title">
        <div>
          <p class="eyebrow">{project.category}</p>
          <h1>{project.name}</h1>
          <p class="lede">{project.summary}</p>
        </div>
        {project.logo && <img src={project.logo} alt={`Logo de ${project.name}`} />}
      </div>
      <div class="actions">
        <a class="button" href={project.repository} target="_blank" rel="noreferrer">
          Ver repositorio
        </a>
        {project.demo && (
          <a class="button secondary" href={project.demo} target="_blank" rel="noreferrer">
            Probar demo
          </a>
        )}
      </div>
    </header>
    <div class="detail-layout shell">
      <div class="prose">
        <section>
          <p class="eyebrow">Sobre el proyecto</p>
          <h2>El problema y el producto</h2>
          <p>{project.description}</p>
        </section>
        <section>
          <p class="eyebrow">Funcionalidades</p>
          <h2>Qué permite hacer</h2>
          <ul class="feature-list">
            {project.features.map((feature) => (
              <li>{feature}</li>
            ))}
          </ul>
        </section>
        <section>
          <p class="eyebrow">Mi aportación</p>
          <h2>Responsabilidad concreta</h2>
          <p>{project.contribution}</p>
        </section>
        {project.team && (
          <section>
            <p class="eyebrow">Equipo</p>
            <h2>Quién hizo qué</h2>
            <dl class="team-list">
              {project.team.map((member) => (
                <div>
                  <dt>{member.name}</dt>
                  <dd>{member.role}</dd>
                </div>
              ))}
            </dl>
          </section>
        )}
      </div>
      <aside class="facts">
        <p class="eyebrow">Ficha técnica</p>
        <dl>
          <dt>Estado</dt>
          <dd>
            <span class="status">{project.status}</span>
            <br />
            {project.statusDetail}
          </dd>
          {project.technologies.map((group) => (
            <>
              <dt>{group.area}</dt>
              <dd>{group.items.join(' · ')}</dd>
            </>
          ))}
        </dl>
        {project.resources && (
          <div class="resources">
            <h3>Recursos</h3>
            {project.resources.map((resource) => (
              <a href={resource.url} target="_blank" rel="noreferrer">
                {resource.label} ↗
              </a>
            ))}
          </div>
        )}
      </aside>
    </div>
  </article>
</BaseLayout>
