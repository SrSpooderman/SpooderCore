---
import BaseLayout from '../../layouts/BaseLayout.astro';
---

<BaseLayout locale="en" title="Demos" description="Status of public demos for SpooderCore projects.">
  <section class="page-hero wrap">
    <p class="eyebrow">DEMOS / STATUS</p>
    <h1>
      Demos
      <br />
      <span class="accent-word">
        public<span class="period">.</span>
      </span>
    </h1>
    <p class="page-lede">
      This section is for public project demos. There are none available right now.
    </p>
    <div class="page-hero-line">
      <span>CURRENT STATUS</span>
      <span>NO DEMOS PUBLISHED</span>
    </div>
  </section>
  <section class="section wrap demos-section">
    <div class="demo-empty">
      <div class="demo-visual">
        <span class="demo-circle circle-a"></span>
        <span class="demo-circle circle-b"></span>
        <span class="demo-plus">+</span>
        <span class="demo-coordinate">DEMO_001 / STANDBY</span>
      </div>
      <div>
        <p class="eyebrow">STATUS / UNAVAILABLE</p>
        <h2>
          No demos
          <br />
          published.
        </h2>
        <p>
          No project in the catalog has a public demo link. Visit each project page for available
          information.
        </p>
        <a class="button button-outline" href="/en/projects">
          View projects <span>↗</span>
        </a>
      </div>
    </div>
  </section>
</BaseLayout>
