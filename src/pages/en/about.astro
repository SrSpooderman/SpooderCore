---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { site } from '../../data/site';
---

<BaseLayout
  locale="en"
  active="/about"
  title="About"
  description="Francisco Valencia, SrSpooderman. Software developer focused on backend systems, APIs, and databases."
>
  <section class="page-hero wrap">
    <p class="eyebrow">FRANCISCO VALENCIA / SrSpooderman</p>
    <h1>
      About
      <br />
      <span class="accent-word">
        me<span class="period">.</span>
      </span>
    </h1>
    <p class="page-lede">
      Software developer focused on backend systems, APIs, databases, and architecture.
    </p>
    <div class="page-hero-line">
      <span>SOFTWARE DEVELOPMENT</span>
      <span>PERSONAL & COLLABORATIVE PROJECTS</span>
    </div>
  </section>

  <section class="section wrap about-section">
    <div class="about-story">
      <p class="eyebrow">01 / PROFILE</p>
      <h2>
        Building
        <br />
        <span class="muted-heading">software.</span>
      </h2>
      <p>
        I am Francisco Valencia, and I build projects as SrSpooderman. I mainly work on backend
        systems, designing and implementing APIs, data models, and integrations between components.
      </p>
      <p>
        I also build web and desktop applications. In collaborative projects, I coordinate with
        frontend and systems teams; Cliponomicon is one example.
      </p>
      <a class="button button-primary" href="/en/projects">
        View projects <span>→</span>
      </a>
    </div>
    <div class="about-aside">
      <span class="about-aside-symbol" aria-hidden="true">
        S<span>.</span>
      </span>
      <p class="eyebrow">ÁREAS DE TRABAJO</p>
      <div class="principle">
        <b>01</b>
        <span>Backend, APIs, and data persistence.</span>
      </div>
      <div class="principle">
        <b>02</b>
        <span>Web and desktop applications.</span>
      </div>
      <div class="principle">
        <b>03</b>
        <span>Deployment and operations with Linux and containers.</span>
      </div>
    </div>
  </section>

  <section class="stack-band">
    <div class="wrap stack-inner">
      <div>
        <p class="eyebrow">02 / TOOLS</p>
        <h2>
          Technologies
          <br />
          <span class="muted-heading">I use.</span>
        </h2>
      </div>
      <div class="stack-list">
        <span>Python</span>
        <span>FastAPI</span>
        <span>SQL</span>
        <span>PostgreSQL</span>
        <span>MySQL</span>
        <span>Docker</span>
        <span>Linux</span>
        <span>React</span>
        <span>TypeScript</span>
        <span>Git</span>
      </div>
    </div>
  </section>

  <section class="section wrap about-connect">
    <div>
      <p class="eyebrow">03 / PUBLIC PROFILE</p>
      <h2>
        Find me
        <br />
        <span class="accent-word">on GitHub.</span>
      </h2>
    </div>
    <div>
      <p>Repositories, code, and activity from SrSpooderman.</p>
      <a class="button button-outline" href={site.github} target="_blank" rel="noreferrer">
        GitHub profile <span>↗</span>
      </a>
    </div>
  </section>
</BaseLayout>
