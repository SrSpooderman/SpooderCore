---
import BaseLayout from '../../layouts/BaseLayout.astro';

const focusAreas = ['Backend engineering', 'APIs', 'Databases', 'Software architecture'];
const technologyGroups = [
  {
    category: 'Backend & architecture',
    technologies: [
      'Python',
      'FastAPI',
      'SQL',
      'Java',
      'Spring',
      'Django',
      'REST APIs',
      'Hexagonal architecture',
      'Domain modeling',
      'Authentication',
    ],
  },
  {
    category: 'Data & infrastructure',
    technologies: [
      'PostgreSQL',
      'MySQL',
      'Redis',
      'SQLAlchemy',
      'Alembic',
      'Docker',
      'Docker Compose',
      'Linux',
      'Ubuntu Server',
      'Nginx',
      'Coolify',
      'Traefik',
      'Cloudflare',
      'Keycloak',
      'Self-hosting',
    ],
  },
  {
    category: 'Frontend & desktop',
    technologies: [
      'React',
      'TypeScript',
      'JavaScript',
      'HTML',
      'CSS',
      'Vite',
      'Puck',
      'PySide6',
      'Kivy',
    ],
  },
  {
    category: 'Automation & tools',
    technologies: [
      'Git',
      'GitHub',
      'GitHub Actions',
      'GitLab',
      'VS Code',
      'CI/CD',
      'Testing',
      'Deployment',
      'FFmpeg',
      'yt-dlp',
      'RQ',
      'MCP',
      'Embedded systems',
      'Microcontrollers',
    ],
  },
];
const projects = [
  {
    number: '01',
    name: 'SpiderFinance',
    description: 'Multi-user web app for organizing and reviewing personal finances.',
    stack: 'Python · FastAPI · PostgreSQL · React',
    href: 'https://github.com/SrSpooderman/SpiderFinance',
  },
  {
    number: '02',
    name: 'Cliponomicon API',
    description: 'Modular backend for managing, processing, and serving videos.',
    stack: 'FastAPI · MySQL · Redis · FFmpeg',
    href: 'https://github.com/SrSpooderman/CliponomiconAPI',
  },
  {
    number: '03',
    name: 'SpiderPortfolio',
    description:
      'Visual page editor with reusable components, drafts, and publishing.',
    stack: 'React · Puck · FastAPI · PostgreSQL',
    href: 'https://github.com/SrSpooderman/Portfolio/tree/develop',
  },
  {
    number: '04',
    name: 'SpiderToMP3',
    description: 'Desktop application for downloading and converting media.',
    stack: 'Python · PySide6 · yt-dlp · FFmpeg',
    href: 'https://github.com/SrSpooderman/SpiderToMP3',
  },
];
---

<BaseLayout
  locale="en"
  active="/"
  title="Francisco Valencia — Backend & Software Developer"
  description="Francisco Valencia, SrSpooderman. Software developer focused on backend systems, APIs, databases, and software architecture."
>
  <section class="profile-hero wrap">
    <div class="profile-intro">
      <p class="eyebrow profile-kicker">
        <span class="profile-kicker-mark"></span> SrSpooderman / PROFILE
      </p>
      <p class="profile-name-label">Hello, I’m</p>
      <h1>
        Francisco
        <br />
        <span>Valencia.</span>
      </h1>
      <p class="profile-role">Backend &amp; Software Developer</p>
      <p class="profile-bio">
        I build software focused on backend systems, APIs, databases, and architecture. I also work
        on frontend when a project needs it, taking applications from design through deployment and
        maintenance.
      </p>
      <div class="profile-actions">
        <a
          class="button button-primary"
          href="https://github.com/SrSpooderman"
          target="_blank"
          rel="noreferrer"
        >
          GitHub <span aria-hidden="true">↗</span>
        </a>
        <a
          class="button button-outline"
          href="https://linkedin.com/in/franciscovaleespa"
          target="_blank"
          rel="noreferrer"
        >
          LinkedIn <span aria-hidden="true">↗</span>
        </a>
      </div>
      <div class="profile-focus" aria-label="Areas of focus">
        {focusAreas.map((area) => (
          <span>{area}</span>
        ))}
      </div>
    </div>

    <aside class="profile-card" aria-label="SrSpooderman's GitHub profile">
      <div class="profile-card-top">
        <span>PUBLIC PROFILE</span>
        <span>GITHUB / 2021</span>
      </div>
      <div class="profile-portrait-wrap">
        <div class="profile-portrait-ring"></div>
        <img
          class="profile-portrait"
          src="https://avatars.githubusercontent.com/u/77443507?v=4"
          alt="Francisco Valencia's GitHub avatar"
          width="176"
          height="176"
          fetchpriority="high"
        />
        <img class="profile-card-logo" src="/brand/spoodercore.png" alt="" width="46" height="46" />
      </div>
      <h2>SrSpooderman</h2>
      <p class="profile-card-name">Francisco Valencia</p>
      <p class="profile-card-role">Software developer</p>
      <div class="profile-card-specialties">
        <span>Backend engineering</span>
        <span>API development</span>
        <span>Software architecture</span>
      </div>
      <a
        class="profile-card-link"
        href="https://github.com/SrSpooderman"
        target="_blank"
        rel="noreferrer"
      >
        View GitHub profile <span aria-hidden="true">↗</span>
      </a>
    </aside>
  </section>

  <section class="profile-stack-band" aria-label="Technologies and tools">
    <div class="wrap profile-stack-inner">
      <div class="profile-stack-heading">
        <p class="eyebrow">TECHNOLOGIES & TOOLS</p>
        <h2>
          Tech stack<span class="period">.</span>
        </h2>
      </div>
      <div class="profile-tech-groups">
        {technologyGroups.map((group, index) => (
          <section class="profile-tech-group">
            <p class="profile-tech-group-index">0{index + 1}</p>
            <h3>{group.category}</h3>
            <div class="profile-tech-list">
              {group.technologies.map((technology) => (
                <span>{technology}</span>
              ))}
            </div>
          </section>
        ))}
      </div>
    </div>
  </section>

  <section class="section wrap profile-work" id="projects">
    <div class="section-heading">
      <div>
        <p class="eyebrow">SELECTED WORK</p>
        <h2>
          Projects I
          <br />
          <span class="muted-heading">work on.</span>
        </h2>
      </div>
      <p class="section-intro">
        A selection of personal projects, from backend services and file processing to desktop
        applications.
      </p>
    </div>
    <div class="profile-project-list">
      {projects.map((project) => (
        <a class="profile-project" href={project.href} target="_blank" rel="noreferrer">
          <span class="profile-project-number">{project.number}</span>
          <div class="profile-project-main">
            <h3>
              {project.name}
              <span aria-hidden="true">↗</span>
            </h3>
            <p>{project.description}</p>
            <span class="profile-project-stack">{project.stack}</span>
          </div>
          <span class="profile-project-arrow" aria-hidden="true">
            ↗
          </span>
        </a>
      ))}
    </div>
    <a class="profile-all-projects" href="/en/projects">
      View all projects <span aria-hidden="true">→</span>
    </a>
  </section>

  <section class="profile-about">
    <div class="wrap profile-about-inner">
      <div>
        <p class="eyebrow">HOW I WORK</p>
        <h2>
          Architecture,
          <br />
          <span>deployment, and maintenance.</span>
        </h2>
      </div>
      <p>
        I also take care of the work around the code: architecture, containers, deployments,
        automation, and maintenance. I aim to build understandable systems that can evolve with a
        project.
      </p>
    </div>
  </section>

  <section class="section wrap profile-connect">
    <p class="eyebrow">PROFESSIONAL CONTACT</p>
    <h2>Let’s talk software.</h2>
    <div class="profile-actions">
      <a
        class="button button-primary"
        href="https://linkedin.com/in/franciscovaleespa"
        target="_blank"
        rel="noreferrer"
      >
        LinkedIn <span aria-hidden="true">↗</span>
      </a>
      <a class="text-link" href="https://github.com/SrSpooderman" target="_blank" rel="noreferrer">
        Explore GitHub <span aria-hidden="true">→</span>
      </a>
    </div>
  </section>
</BaseLayout>
