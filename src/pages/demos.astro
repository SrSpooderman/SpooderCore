---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="Demos" description="Estado de las demos públicas de los proyectos SpooderCore.">
  <section class="page-hero wrap">
    <p class="eyebrow">DEMOS / ESTADO</p>
    <h1>
      Demos
      <br />
      <span class="accent-word">
        públicas<span class="period">.</span>
      </span>
    </h1>
    <p class="page-lede">
      Esta sección se reserva para las demos públicas de los proyectos. Actualmente no hay ninguna.
    </p>
    <div class="page-hero-line">
      <span>ESTADO ACTUAL</span>
      <span>NO HAY DEMOS PUBLICADAS</span>
    </div>
  </section>
  <section class="section wrap demos-section">
    <div class="demo-empty">
      <div class="demo-visual">
        <span class="demo-circle circle-a"></span>
        <span class="demo-circle circle-b"></span>
        <span class="demo-plus">+</span>
        <span class="demo-coordinate">DEMO_001 / STANDBY</span>
      </div>
      <div>
        <p class="eyebrow">ESTADO / NO DISPONIBLE</p>
        <h2>
          No hay demos
          <br />
          publicadas.
        </h2>
        <p>
          Ningún proyecto del catálogo tiene una demo pública enlazada. Consulta la ficha de cada
          proyecto para ver la información disponible.
        </p>
        <a class="button button-outline" href="/projects">
          Ver proyectos <span>↗</span>
        </a>
      </div>
    </div>
  </section>
</BaseLayout>
