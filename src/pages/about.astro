---
import BaseLayout from '../layouts/BaseLayout.astro';
import { site } from '../data/site';
---

<BaseLayout
  active="/about"
  title="Acerca de"
  description="Francisco Valencia, SrSpooderman. Desarrollador de software centrado en backend, APIs y bases de datos."
>
  <section class="page-hero wrap">
    <p class="eyebrow">FRANCISCO VALENCIA / SrSpooderman</p>
    <h1>
      Acerca
      <br />
      <span class="accent-word">
        de mí<span class="period">.</span>
      </span>
    </h1>
    <p class="page-lede">
      Desarrollador de software centrado en backend, APIs, bases de datos y arquitectura.
    </p>
    <div class="page-hero-line">
      <span>DESARROLLO DE SOFTWARE</span>
      <span>PROYECTOS PROPIOS Y COLABORATIVOS</span>
    </div>
  </section>

  <section class="section wrap about-section">
    <div class="about-story">
      <p class="eyebrow">01 / PERFIL</p>
      <h2>
        Desarrollo de
        <br />
        <span class="muted-heading">software.</span>
      </h2>
      <p>
        Soy Francisco Valencia y desarrollo proyectos bajo el nombre SrSpooderman. Trabajo
        principalmente en backend: diseño e implemento APIs, modelos de datos e integración entre
        componentes.
      </p>
      <p>
        También construyo aplicaciones web y de escritorio. En proyectos colaborativos, mi trabajo
        se coordina con las áreas de frontend y sistemas; Cliponomicon es un ejemplo de ese tipo de
        colaboración.
      </p>
      <a class="button button-primary" href="/projects">
        Ver proyectos <span>→</span>
      </a>
    </div>
    <div class="about-aside">
      <span class="about-aside-symbol" aria-hidden="true">
        S<span>.</span>
      </span>
      <p class="eyebrow">ÁREAS DE TRABAJO</p>
      <div class="principle">
        <b>01</b>
        <span>Backend, APIs y persistencia de datos.</span>
      </div>
      <div class="principle">
        <b>02</b>
        <span>Aplicaciones web y de escritorio.</span>
      </div>
      <div class="principle">
        <b>03</b>
        <span>Despliegue y operación con Linux y contenedores.</span>
      </div>
    </div>
  </section>

  <section class="stack-band">
    <div class="wrap stack-inner">
      <div>
        <p class="eyebrow">02 / HERRAMIENTAS</p>
        <h2>
          Tecnologías
          <br />
          <span class="muted-heading">habituales.</span>
        </h2>
      </div>
      <div class="stack-list">
        <span>Python</span>
        <span>FastAPI</span>
        <span>SQL</span>
        <span>PostgreSQL</span>
        <span>MySQL</span>
        <span>Docker</span>
        <span>Linux</span>
        <span>React</span>
        <span>TypeScript</span>
        <span>Git</span>
      </div>
    </div>
  </section>

  <section class="section wrap about-connect">
    <div>
      <p class="eyebrow">03 / PERFIL PÚBLICO</p>
      <h2>
        Encuéntrame
        <br />
        <span class="accent-word">en GitHub.</span>
      </h2>
    </div>
    <div>
      <p>Repositorios, código y actividad de SrSpooderman.</p>
      <a class="button button-outline" href={site.github} target="_blank" rel="noreferrer">
        Perfil de GitHub <span>↗</span>
      </a>
    </div>
  </section>
</BaseLayout>
