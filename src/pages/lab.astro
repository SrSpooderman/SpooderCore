---
import BaseLayout from '../layouts/BaseLayout.astro';

const metrics = [
  { name: 'CPU', description: 'Porcentaje de uso del procesador.' },
  { name: 'Memoria', description: 'Porcentaje de memoria utilizada.' },
  { name: 'Almacenamiento', description: 'Uso del filesystem configurado.' },
];
---

<BaseLayout
  active="/lab"
  title="Homelab"
  description="Estado y métricas agregadas del servidor de SpooderCore."
>
  <section class="page-hero wrap">
    <p class="eyebrow">HOMELAB / SERVIDOR</p>
    <h1>
      Estado del
      <br />
      <span class="accent-word">
        servidor<span class="period">.</span>
      </span>
    </h1>
    <p class="page-lede">Métricas agregadas de CPU, memoria y almacenamiento.</p>
    <div class="page-hero-line">
      <span>FUENTE: SPOODERSERVERMETRICS</span>
      <span>MUESTRA Y FRESCURA</span>
    </div>
  </section>

  <section class="section wrap lab-section">
    <div class="lab-heading">
      <div>
        <p class="eyebrow">01 / RECURSOS</p>
        <h2>
          Uso del
          <br />
          <span class="muted-heading">servidor.</span>
        </h2>
      </div>
    </div>

    <div class="tech-grid server-metric-grid">
      {metrics.map((metric, index) => (
        <article class="tech-card server-metric-card">
          <span class="tech-index">0{index + 1} / HOST</span>
          <span class="eyebrow">USO ACTUAL</span>
          <h3>{metric.name}</h3>
          <p>{metric.description}</p>
          <div class="server-metric-readout">
            <span class="server-metric-value" id={`metric-${index}`} aria-label="Cargando dato">
              —
            </span>
          </div>
          <div
            class="server-metric-track"
            role="progressbar"
            aria-label={`Uso de ${metric.name}`}
            aria-valuemin="0"
            aria-valuemax="100"
            aria-valuetext="Esperando datos"
            aria-busy="true"
          >
            <span class="server-metric-fill" id={`metric-bar-${index}`}></span>
          </div>
        </article>
      ))}
    </div>

    <div class="metrics-note">
      <span class="metrics-mark" aria-hidden="true">
        ◎
      </span>
      <div>
        <p class="eyebrow">ESTADO DE LA FUENTE</p>
        <h3 id="metrics-status" aria-live="polite">
          Consultando el servidor.
        </h3>
        <p>
          <span id="metrics-timestamp">Esperando la hora de la última muestra.</span>
        </p>
      </div>
      <span class="coming-chip" id="metrics-freshness">
        CARGANDO
      </span>
    </div>

    <div class="metrics-note services-note">
      <span class="metrics-mark" aria-hidden="true">
        ⌁
      </span>
      <div>
        <p class="eyebrow">SERVICIOS</p>
        <h3>Sin métricas por servicio.</h3>
        <p>
          La versión actual de SpooderServerMetrics devuelve una lista vacía en este apartado; sus
          métricas cubren el host.
        </p>
      </div>
      <a
        class="metrics-source-link"
        href="https://github.com/SrSpooderman/SpooderServerMetrics"
        target="_blank"
        rel="noreferrer"
      >
        Contrato ↗
      </a>
    </div>
  </section>
</BaseLayout>

<script>
  interface MetricsSummary {
    schema_version: string;
    sampled_at: string;
    generated_at: string;
    stale: boolean;
    host: {
      cpu_percent: number;
      memory_percent: number;
      storage_percent: number;
    };
  }

  const status = document.querySelector<HTMLElement>('#metrics-status');
  const freshness = document.querySelector<HTMLElement>('#metrics-freshness');
  const timestamp = document.querySelector<HTMLElement>('#metrics-timestamp');

  function formatPercent(value: number): string {
    return `${value.toLocaleString('es-ES', { maximumFractionDigits: 1 })}%`;
  }

  function showUnavailable(): void {
    if (status) status.textContent = 'Métricas no disponibles.';
    if (freshness) freshness.textContent = 'SIN CONEXIÓN';
    if (timestamp) timestamp.textContent = 'No se pudo obtener una muestra. ';
  }

  try {
    const response = await fetch('/api/metrics/summary', { cache: 'no-store' });
    if (!response.ok) throw new Error('Metrics endpoint unavailable');

    const data = (await response.json()) as MetricsSummary;
    if (
      data.schema_version !== '1.0' ||
      typeof data.sampled_at !== 'string' ||
      typeof data.stale !== 'boolean' ||
      ![data.host?.cpu_percent, data.host?.memory_percent, data.host?.storage_percent].every(
        (value) => typeof value === 'number' && Number.isFinite(value),
      )
    ) {
      throw new Error('Invalid metrics response');
    }

    const values = [data.host.cpu_percent, data.host.memory_percent, data.host.storage_percent];
    values.forEach((value, index) => {
      const target = document.querySelector<HTMLElement>(`#metric-${index}`);
      if (target) target.textContent = formatPercent(value);

      const progress = document.querySelector<HTMLElement>(`#metric-bar-${index}`)?.parentElement;
      if (progress) {
        const boundedValue = Math.min(100, Math.max(0, value));
        progress.setAttribute('aria-valuenow', String(boundedValue));
        progress.setAttribute('aria-valuetext', formatPercent(value));
        progress.setAttribute('aria-busy', 'false');
        progress.style.setProperty('--metric-value', `${boundedValue}%`);
      }
    });

    const sampledAt = new Date(data.sampled_at);
    if (Number.isNaN(sampledAt.valueOf())) throw new Error('Invalid sample timestamp');
    if (timestamp) {
      timestamp.textContent = `Muestra: ${sampledAt.toLocaleString('es-ES')}. `;
    }
    if (status) status.textContent = data.stale ? 'Muestra desactualizada.' : 'Muestra actual.';
    if (freshness) freshness.textContent = data.stale ? 'DESACTUALIZADA' : 'ACTUALIZADA';
  } catch {
    showUnavailable();
  }
</script>
