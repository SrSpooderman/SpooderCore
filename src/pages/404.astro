---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="Página no encontrada">
  <section class="not-found wrap">
    <p class="eyebrow">ERROR 404 / RUTA PERDIDA</p>
    <h1>
      Esta página
      <br />
      <span class="accent-word">
        no existe<span class="period">.</span>
      </span>
    </h1>
    <p>Puede que el enlace haya cambiado o que todavía no hayamos llegado hasta aquí.</p>
    <a class="button button-primary" href="/">
      Volver al inicio <span>↗</span>
    </a>
  </section>
</BaseLayout>
