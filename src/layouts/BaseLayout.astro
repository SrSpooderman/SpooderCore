---
import '../styles/global.css';
import { site } from '../data/site';
import { localizedPath, localeNames, locales, messages, type Locale } from '../i18n/locales';
interface Props {
  title?: string;
  description?: string;
  active?: string;
  locale?: Locale;
}
const { title = site.name, active = '', locale = 'es' } = Astro.props;
const t = messages(locale, 'common');
const description = Astro.props.description ?? t.siteDescription;
const pageTitle = title === site.name ? title : `${title} — ${site.name}`;
const localePattern = new RegExp(`^/(?:${locales.join('|')})(?=/|$)`);
const path = Astro.url.pathname.replace(localePattern, '') || '/';
const canonicalPath = localizedPath(locale, path);
const canonical = new URL(canonicalPath, siteUrl()).toString();
const languages = locales.map((code) => ({ code, name: (localeNames as Record<string, string>)[code] }));
const nav = [
  { href: '/', label: t.home },
  { href: '/projects', label: t.projects },
  { href: '/downloads', label: t.downloads },
  { href: '/lab', label: t.lab },
  { href: '/about', label: t.about },
];
const localized = (href: string) => localizedPath(locale, href);
function siteUrl() {
  return 'https://www.spoodercore.com';
}
---

<!doctype html>
<html lang={locale}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#111110" />
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" type="image/png" href="/brand/spoodercore.png" />
    <link rel="apple-touch-icon" href="/brand/spoodercore.png" />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={site.name} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content="https://www.spoodercore.com/brand/spoodercore.png" />
    <meta property="og:image:type" content="image/png" />
    <meta property="og:image:width" content="1254" />
    <meta property="og:image:height" content="1254" />
    <meta property="og:image:alt" content={t.brandAlt} />
    <meta name="twitter:card" content="summary" />
    {languages.map(({ code }) => <link rel="alternate" hreflang={code} href={new URL(localizedPath(code as Locale, path), siteUrl()).toString()} />)}
    <title>{pageTitle}</title>
  </head>
  <body>
    <a class="skip-link" href="#contenido">
      {t.skipToContent}
    </a>
    <header class="site-header">
      <div class="header-inner wrap">
        <a class="wordmark" href={localized('/')} aria-label={t.brandHome}>
          <img class="brand-logo" src="/brand/spoodercore.png" alt="" width="32" height="32" />
          <span>
            spooder<span class="wordmark-light">core</span>
          </span>
        </a>
        <nav class="main-nav" aria-label={t.navigation}>
          {nav.map((item) => (
            <a
              href={localized(item.href)}
              class:list={{ active: active === item.href }}
              aria-current={active === item.href ? 'page' : undefined}
            >
              <span>{item.label}</span>
            </a>
          ))}
        </nav>
        <div class="header-controls">
          <button class="header-control" type="button" data-theme-toggle aria-label={t.themeToggle} title={t.themeToggle} data-light-label={t.lightMode} data-dark-label={t.darkMode} data-light-title={t.lightModeTitle} data-dark-title={t.darkModeTitle}>☼</button>
          <details class="language-switcher">
            <summary class="header-control" aria-label={t.switchLanguage}>{locale.toUpperCase()}</summary>
            <div class="language-options">
              {languages.map(({ code, name }) => (
                <a href={localizedPath(code as Locale, path)} aria-current={locale === code ? 'true' : undefined}>{name}</a>
              ))}
            </div>
          </details>
          <a class="header-github" href={site.github} target="_blank" rel="noreferrer">
            GitHub <span aria-hidden="true">↗</span>
          </a>
        </div>
        <button
          class="menu-toggle"
          type="button"
          aria-expanded="false"
          aria-controls="mobile-nav"
          aria-label={t.openMenu}
          data-open-label={t.openMenu}
          data-close-label={t.closeMenu}
        >
          <span></span>
          <span></span>
        </button>
      </div>
      <nav id="mobile-nav" class="mobile-nav wrap" aria-label={t.mobileNavigation} hidden>
        {nav.map((item) => (
          <a href={localized(item.href)}>
            <span>{item.label}</span>
            <span aria-hidden="true">↗</span>
          </a>
        ))}
        <a href={site.github} target="_blank" rel="noreferrer">
          GitHub<span aria-hidden="true">↗</span>
        </a>
      </nav>
    </header>
    <main id="contenido">
      <slot />
    </main>
    <footer class="site-footer">
      <div class="wrap footer-top">
        <div>
          <a class="wordmark footer-wordmark" href={localized('/')}>
            <span>
              spooder<span class="wordmark-light">core</span>
            </span>
          </a>
          <p>
            <span>{t.footerBio}</span>
          </p>
        </div>
        <div class="footer-links">
          <div>
            <span class="footer-label">{t.explore}</span>
            <a href={localized('/')}>{t.home}</a>
            <a href={localized('/projects')}>{t.projects}</a>
            <a href={localized('/downloads')}>{t.downloads}</a>
            <a href={localized('/lab')}>{t.lab}</a>
          </div>
          <div>
            <span class="footer-label">{t.connect}</span>
            <a href={localized('/about')}>{t.about}</a>
            <a href={site.github} target="_blank" rel="noreferrer">
              GitHub ↗
            </a>
          </div>
        </div>
      </div>
      <div class="wrap footer-bottom">
        <span>© {new Date().getFullYear()} SpooderCore</span>
        <span>{t.footerCopyright}</span>
      </div>
    </footer>
    <script>
      const themeButton = document.querySelector<HTMLButtonElement>('[data-theme-toggle]');
      const theme = localStorage.getItem('spoodercore-theme') || (matchMedia('(prefers-color-scheme: light)').matches ? 'light' : 'dark');
      document.documentElement.dataset.theme = theme;
      const updateThemeButton = () => {
        const light = document.documentElement.dataset.theme === 'light';
        if (themeButton) {
          themeButton.textContent = light ? '☾' : '☼';
          themeButton.setAttribute('aria-label', light ? themeButton.dataset.darkLabel ?? '' : themeButton.dataset.lightLabel ?? '');
          themeButton.title = light ? themeButton.dataset.darkTitle ?? '' : themeButton.dataset.lightTitle ?? '';
        }
        document.querySelector<HTMLMetaElement>('meta[name="theme-color"]')?.setAttribute('content', light ? '#f7f6f2' : '#111110');
      };
      updateThemeButton();
      themeButton?.addEventListener('click', () => {
        const next = document.documentElement.dataset.theme === 'light' ? 'dark' : 'light';
        document.documentElement.dataset.theme = next;
        localStorage.setItem('spoodercore-theme', next);
        updateThemeButton();
      });
      const button = document.querySelector<HTMLButtonElement>('.menu-toggle');
      const menu = document.querySelector<HTMLElement>('#mobile-nav');
      button?.addEventListener('click', () => {
        const open = button.getAttribute('aria-expanded') !== 'true';
        button.setAttribute('aria-expanded', String(open));
        button.setAttribute('aria-label', open ? button.dataset.closeLabel ?? '' : button.dataset.openLabel ?? '');
        if (menu) menu.hidden = !open;
      });
    </script>
  </body>
</html>
