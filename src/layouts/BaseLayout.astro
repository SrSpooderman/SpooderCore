---
import '../styles/global.css';
import { site } from '../data/site';
interface Props {
  title?: string;
  description?: string;
  active?: string;
  locale?: 'es' | 'en';
}
const { title = site.name, description = site.description, active = '', locale = 'es' } = Astro.props;
const english = locale === 'en';
const pageTitle = title === site.name ? title : `${title} — ${site.name}`;
const path = Astro.url.pathname.replace(/^\/en(?=\/|$)/, '') || '/';
const canonicalPath = english ? `/en${path === '/' ? '' : path}` : path;
const canonical = new URL(canonicalPath, siteUrl()).toString();
const nav = english
  ? [{ href: '/', label: 'Profile' }, { href: '/projects', label: 'Projects' }, { href: '/downloads', label: 'Downloads' }, { href: '/lab', label: 'Lab' }, { href: '/about', label: 'About' }]
  : site.navigation;
const localized = (href: string) => english ? `/en${href === '/' ? '' : href}` : href;
function siteUrl() {
  return 'https://www.spoodercore.com';
}
---

<!doctype html>
<html lang={locale}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#111110" />
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <link rel="icon" type="image/png" href="/brand/spoodercore.png" />
    <link rel="apple-touch-icon" href="/brand/spoodercore.png" />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={site.name} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content="https://www.spoodercore.com/brand/spoodercore.png" />
    <meta property="og:image:type" content="image/png" />
    <meta property="og:image:width" content="1254" />
    <meta property="og:image:height" content="1254" />
    <meta property="og:image:alt" content="Logo de SpooderCore" />
    <meta name="twitter:card" content="summary" />
    <link rel="alternate" hreflang="es" href={new URL(path, siteUrl()).toString()} />
    <link rel="alternate" hreflang="en" href={new URL(`/en${path === '/' ? '' : path}`, siteUrl()).toString()} />
    <title>{pageTitle}</title>
  </head>
  <body>
    <a class="skip-link" href="#contenido">
      {english ? 'Skip to content' : 'Saltar al contenido'}
    </a>
    <header class="site-header">
      <div class="header-inner wrap">
        <a class="wordmark" href={localized('/')} aria-label={english ? 'SpooderCore, home' : 'SpooderCore, inicio'}>
          <img class="brand-logo" src="/brand/spoodercore.png" alt="" width="32" height="32" />
          <span>
            spooder<span class="wordmark-light">core</span>
          </span>
        </a>
        <nav class="main-nav" aria-label={english ? 'Main navigation' : 'Navegación principal'}>
          {nav.map((item) => (
            <a
              href={localized(item.href)}
              class:list={{ active: active === item.href }}
              aria-current={active === item.href ? 'page' : undefined}
            >
              <span>{item.label}</span>
            </a>
          ))}
        </nav>
        <div class="header-controls">
          <button class="header-control" type="button" data-theme-toggle aria-label="Cambiar tema" title="Cambiar tema">☼</button>
          <a class="header-control language-toggle" href={english ? path : `/en${path === '/' ? '' : path}`} aria-label={english ? 'Cambiar a español' : 'Switch to English'} title={english ? 'Español' : 'English'}>{english ? 'ES' : 'EN'}</a>
          <a class="header-github" href={site.github} target="_blank" rel="noreferrer">
            GitHub <span aria-hidden="true">↗</span>
          </a>
        </div>
        <button
          class="menu-toggle"
          type="button"
          aria-expanded="false"
          aria-controls="mobile-nav"
          aria-label={english ? 'Open menu' : 'Abrir menú'}
        >
          <span></span>
          <span></span>
        </button>
      </div>
      <nav id="mobile-nav" class="mobile-nav wrap" aria-label={english ? 'Mobile navigation' : 'Navegación móvil'} hidden>
        {nav.map((item) => (
          <a href={localized(item.href)}>
            <span>{item.label}</span>
            <span aria-hidden="true">↗</span>
          </a>
        ))}
        <a href={site.github} target="_blank" rel="noreferrer">
          GitHub<span aria-hidden="true">↗</span>
        </a>
      </nav>
    </header>
    <main id="contenido">
      <slot />
    </main>
    <footer class="site-footer">
      <div class="wrap footer-top">
        <div>
          <a class="wordmark footer-wordmark" href={localized('/')}>
            <img
              class="brand-logo footer-brand-logo"
              src="/brand/spoodercore.png"
              alt=""
              width="28"
              height="28"
            />
            <span>
              spooder<span class="wordmark-light">core</span>
            </span>
          </a>
          <p>
            <span>{english ? 'Francisco Valencia · Software developer.' : 'Francisco Valencia · Desarrollador de software.'}</span>
            <br />
            <span>{english ? 'SrSpooderman on GitHub.' : 'SrSpooderman en GitHub.'}</span>
          </p>
        </div>
        <div class="footer-links">
          <div>
            <span class="footer-label">{english ? 'Explore' : 'Explora'}</span>
            <a href={localized('/')} >{english ? 'Profile' : 'Perfil'}</a>
            <a href={localized('/projects')}>{english ? 'Projects' : 'Proyectos'}</a>
            <a href={localized('/downloads')}>{english ? 'Downloads' : 'Descargas'}</a>
            <a href={localized('/lab')}>{english ? 'Lab' : 'Laboratorio'}</a>
          </div>
          <div>
            <span class="footer-label">{english ? 'Connect' : 'Conecta'}</span>
            <a href={localized('/about')}>{english ? 'About' : 'Acerca de'}</a>
            <a href={site.github} target="_blank" rel="noreferrer">
              GitHub ↗
            </a>
          </div>
        </div>
      </div>
      <div class="wrap footer-bottom">
        <span>© {new Date().getFullYear()} SpooderCore</span>
        <span>{english ? 'Static site generated with Astro.' : 'Sitio estático generado con Astro.'}</span>
      </div>
    </footer>
    <script>
      const themeButton = document.querySelector<HTMLButtonElement>('[data-theme-toggle]');
      const theme = localStorage.getItem('spoodercore-theme') || (matchMedia('(prefers-color-scheme: light)').matches ? 'light' : 'dark');
      document.documentElement.dataset.theme = theme;
      const updateThemeButton = () => {
        const light = document.documentElement.dataset.theme === 'light';
        if (themeButton) {
          themeButton.textContent = light ? '☾' : '☼';
          const english = document.documentElement.lang === 'en';
          themeButton.setAttribute('aria-label', light ? (english ? 'Switch to dark mode' : 'Activar modo oscuro') : (english ? 'Switch to light mode' : 'Activar modo claro'));
          themeButton.title = light ? (english ? 'Dark mode' : 'Modo oscuro') : (english ? 'Light mode' : 'Modo claro');
        }
        document.querySelector<HTMLMetaElement>('meta[name="theme-color"]')?.setAttribute('content', light ? '#f7f6f2' : '#111110');
      };
      updateThemeButton();
      themeButton?.addEventListener('click', () => {
        const next = document.documentElement.dataset.theme === 'light' ? 'dark' : 'light';
        document.documentElement.dataset.theme = next;
        localStorage.setItem('spoodercore-theme', next);
        updateThemeButton();
      });
      const button = document.querySelector<HTMLButtonElement>('.menu-toggle');
      const menu = document.querySelector<HTMLElement>('#mobile-nav');
      button?.addEventListener('click', () => {
        const open = button.getAttribute('aria-expanded') !== 'true';
        button.setAttribute('aria-expanded', String(open));
        const english = document.documentElement.lang === 'en';
        button.setAttribute('aria-label', open ? (english ? 'Close menu' : 'Cerrar menú') : (english ? 'Open menu' : 'Abrir menú'));
        if (menu) menu.hidden = !open;
      });
    </script>
  </body>
</html>
