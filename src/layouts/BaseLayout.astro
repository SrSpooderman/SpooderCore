---
import '../styles/global.css';
import { site } from '../data/site';
interface Props {
  title?: string;
  description?: string;
  active?: string;
}
const { title = site.name, description = site.description, active = '' } = Astro.props;
const pageTitle = title === site.name ? title : `${title} — ${site.name}`;
const canonical = new URL(Astro.url.pathname, siteUrl()).toString();
function siteUrl() {
  return 'https://www.spoodercore.com';
}
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#111110" />
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <link rel="icon" type="image/png" href="/brand/spoodercore.png" />
    <link rel="apple-touch-icon" href="/brand/spoodercore.png" />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={site.name} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content="https://www.spoodercore.com/brand/spoodercore.png" />
    <meta property="og:image:type" content="image/png" />
    <meta property="og:image:width" content="1254" />
    <meta property="og:image:height" content="1254" />
    <meta property="og:image:alt" content="Logo de SpooderCore" />
    <meta name="twitter:card" content="summary" />
    <title>{pageTitle}</title>
  </head>
  <body>
    <a class="skip-link" href="#contenido">
      Saltar al contenido
    </a>
    <header class="site-header">
      <div class="header-inner wrap">
        <a class="wordmark" href="/" aria-label="SpooderCore, inicio">
          <img class="brand-logo" src="/brand/spoodercore.png" alt="" width="32" height="32" />
          <span>
            spooder<span class="wordmark-light">core</span>
          </span>
        </a>
        <nav class="main-nav" aria-label="Navegación principal">
          {site.navigation.map((item) => (
            <a
              href={item.href}
              class:list={{ active: active === item.href }}
              aria-current={active === item.href ? 'page' : undefined}
            >
              {item.label}
            </a>
          ))}
        </nav>
        <a class="header-github" href={site.github} target="_blank" rel="noreferrer">
          GitHub <span aria-hidden="true">↗</span>
        </a>
        <button
          class="menu-toggle"
          type="button"
          aria-expanded="false"
          aria-controls="mobile-nav"
          aria-label="Abrir menú"
        >
          <span></span>
          <span></span>
        </button>
      </div>
      <nav id="mobile-nav" class="mobile-nav wrap" aria-label="Navegación móvil" hidden>
        {site.navigation.map((item) => (
          <a href={item.href}>
            {item.label}
            <span aria-hidden="true">↗</span>
          </a>
        ))}
        <a href={site.github} target="_blank" rel="noreferrer">
          GitHub<span aria-hidden="true">↗</span>
        </a>
      </nav>
    </header>
    <main id="contenido">
      <slot />
    </main>
    <footer class="site-footer">
      <div class="wrap footer-top">
        <div>
          <a class="wordmark footer-wordmark" href="/">
            <img
              class="brand-logo footer-brand-logo"
              src="/brand/spoodercore.png"
              alt=""
              width="28"
              height="28"
            />
            <span>
              spooder<span class="wordmark-light">core</span>
            </span>
          </a>
          <p>
            Francisco Valencia · Desarrollador de software.
            <br />
            SrSpooderman en GitHub.
          </p>
        </div>
        <div class="footer-links">
          <div>
            <span class="footer-label">Explora</span>
            <a href="/">Perfil</a>
            <a href="/projects">Proyectos</a>
            <a href="/downloads">Descargas</a>
            <a href="/lab">Laboratorio</a>
          </div>
          <div>
            <span class="footer-label">Conecta</span>
            <a href="/about">Acerca de</a>
            <a href={site.github} target="_blank" rel="noreferrer">
              GitHub ↗
            </a>
          </div>
        </div>
      </div>
      <div class="wrap footer-bottom">
        <span>© {new Date().getFullYear()} SpooderCore</span>
        <span>Sitio estático generado con Astro.</span>
      </div>
    </footer>
    <script>
      const button = document.querySelector<HTMLButtonElement>('.menu-toggle');
      const menu = document.querySelector<HTMLElement>('#mobile-nav');
      button?.addEventListener('click', () => {
        const open = button.getAttribute('aria-expanded') !== 'true';
        button.setAttribute('aria-expanded', String(open));
        button.setAttribute('aria-label', open ? 'Cerrar menú' : 'Abrir menú');
        if (menu) menu.hidden = !open;
      });
    </script>
  </body>
</html>
